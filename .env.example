# SnipShot Desktop Configuration

# -----------------------------------------------------------------------
# Supabase credentials — get from Supabase dashboard → Project Settings → API
# -----------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# NOTE: Do NOT add SUPABASE_SERVICE_KEY here.
# Service keys bypass Row Level Security and must NEVER ship in a desktop app.

# -----------------------------------------------------------------------
# Translator API (separate backend service)
# -----------------------------------------------------------------------
TRANSLATOR_URL=http://localhost:8001

# -----------------------------------------------------------------------
# Translation defaults
# -----------------------------------------------------------------------
TRANSLATION_TARGET_LANG=ENG
TRANSLATION_INPAINTER=lama_large

# -----------------------------------------------------------------------
# Legacy — database_api server (deprecated; kept for rollback only)
# -----------------------------------------------------------------------
# API_BASE_URL=http://localhost:8000/api
